 "lines": [
  {
   "id": "L00",
   "t": 0.25,
   "d": 1.43,
   "text": "Por fin tienes tu página web."
  },
  {
   "id": "L01",
   "t": 2.0,
   "d": 4.07,
   "text": "Quedó bonita. La publicaste. La compartiste en tus estados."
  },
  {
   "id": "L02",
   "t": 7.1,
   "d": 2.55,
   "text": "Pasa un mes, y no te llega ni un mensaje."
  },
  {
   "id": "L03",
   "t": 10.1,
   "d": 3.22,
   "text": "Un cliente te busca en Google, y encuentra a tu competencia."
  },
  {
   "id": "L04",
   "t": 13.8,
   "d": 3.7,
   "text": "Otro abre tu web en el teléfono, espera ocho segundos, y se va."
  },
  {
   "id": "L05",
   "t": 18.3,
   "d": 4.73,
   "text": "Y tu web sigue ahí, cobrando hosting, sin traerte un solo cliente."
  },
  {
   "id": "L06",
   "t": 24.2,
   "d": 2.93,
   "text": "Antes de pagar por una web, exige tres cosas."
  },
  {
   "id": "L07",
   "t": 27.6,
   "d": 3.08,
   "text": "Uno: que cargue en menos de tres segundos en el teléfono."
  },
  {
   "id": "L08",
   "t": 31.2,
   "d": 4.28,
   "text": "Dos: un botón de WhatsApp a un toque, en todas las páginas."
  },
  {
   "id": "L09",
   "t": 36.0,
   "d": 3.25,
   "text": "Tres: que Google la encuentre cuando alguien busca lo que vendes."
  },
  {
   "id": "L10",
   "t": 39.8,
   "d": 2.38,
   "text": "Y pide el precio por escrito, antes de empezar."
  },
  {
   "id": "L11",
   "t": 43.4,
   "d": 2.24,
   "text": "Tener web no significa tener clientes."
  },
  {
   "id": "L12",
   "t": 47.0,
   "d": 5.71,
   "text": "En Meridian Digital hacemos webs que te traen clientes. Escríbenos por WhatsApp y cotiza en segundos."
  }
 ],
